# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. Only this example file is committed.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# Frontend origin allowed by CORS (comma-separate multiple origins)
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/ai-interviewer

# Redis (refresh-token whitelist, access-token blocklist, rate limiting)
REDIS_URL=redis://localhost:6379

# JWT — generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
