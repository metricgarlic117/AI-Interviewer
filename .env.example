# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is ignored by git.
# ---------------------------------------------------------------------------

# --- Server-only secrets (never exposed to the browser) ---

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# AssemblyAI API key — https://www.assemblyai.com/app
ASSEMBLYAI_API_KEY=

# Firebase Admin service account, used to verify user ID tokens on API routes.
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Paste the JSON either raw or base64-encoded (base64 recommended:
#   base64 -w0 service-account.json).
# On Google Cloud / Firebase App Hosting you can omit this and rely on
# Application Default Credentials instead.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Firebase web app config (exposed to the browser — not secret) ---
# Firebase Console → Project settings → General → Your apps → SDK setup

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
